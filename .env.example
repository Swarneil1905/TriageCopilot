# Copy to .env at repo root and fill in for local dev.

# Postgres connection (matches docker-compose.yml / a local `supabase start`)
DATABASE_URL=postgres://triage_copilot:triage_copilot@localhost:54329/triage_copilot

# Comma-separated list of origins the backend's CORS policy (app.ts) and its
# matching Origin/CSRF preHandler (security.ts) trust with a credentialed
# (cookie-carrying) request. Optional for local dev: defaults to the local
# frontend's own origin, http://localhost:3000, so `npm run frontend:dev` /
# `npm run backend:dev` keep working with zero new required setup. The real
# Railway backend sets this explicitly to the deployed frontend's real
# origin, e.g.:
#   CORS_ALLOWED_ORIGINS=https://frontend-production-5a1c9.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# LLM provider for the triage agent. "fake" runs a deterministic scripted
# agent with zero external calls, so the whole demo works with no API key.
# Set to "anthropic" + provide a real key to see the live tool-calling agent
# against Claude, or set to "ollama" to run it against a local open-source
# model with no API key and no data leaving your machine.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=

# Only used when LLM_PROVIDER=ollama. Requires `ollama serve` running
# locally and a tool-calling-capable model already pulled, e.g.:
#   ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Signs the session cookie used only by login/signup (which gates the public
# live-AI-demo button on the landing page). Optional for local dev: if
# unset, a random one is generated per process start with a console warning,
# which is fine for local/test use but means every restart invalidates
# existing sessions. Generate a real one for anything longer-lived with:
#   openssl rand -hex 32
SESSION_SECRET=

# How many live-demo agent runs (routes/demo.ts) are allowed per UTC day,
# across all accounts combined, a hard cap on the site owner's LLM API
# spend once LLM_PROVIDER is pointed at a real hosted model. Optional,
# defaults to 20.
DEMO_DAILY_CAP=20

# Comma-separated allowlist of emails treated as admin: unlimited AI agent
# use, no free-tier quota, no Stripe subscription required (see admin.ts and
# quota.ts). Not a database role; this is the one, single source of truth
# for admin status, checked at request time against the logged-in session's
# own email. Optional for local dev.
ADMIN_EMAILS=swarneil1905@gmail.com

# Google sign-in (routes/oauth.ts), via @fastify/oauth2. Leave both blank for
# local dev and CI if you don't need to exercise the Google flow; the rest
# of the app (including the whole backend test suite) works with zero Google
# credentials present. Create these at console.cloud.google.com (APIs &
# Services > Credentials > OAuth client ID, Web application), with an
# authorized redirect URI of BACKEND_PUBLIC_URL below plus
# /api/auth/google/callback, for both your local dev URL and the real
# Railway backend URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The backend's own public URL, used to build the Google OAuth callback URL
# above: http://localhost:4000 locally, the real Railway backend domain in
# production.
BACKEND_PUBLIC_URL=http://localhost:4000
# Where to send the browser back to once a Google login, a Stripe checkout,
# or a Stripe billing-portal session completes.
FRONTEND_PUBLIC_URL=http://localhost:3000

# Stripe billing (routes/billing.ts): the $19.99/month subscription that
# free-tier users hit once they exhaust FREE_REQUEST_LIMIT (see quota.ts).
# Use Stripe's test-mode keys until you're deliberately ready to go live;
# never develop against live keys. Leave all three blank for local dev and
# CI if you don't need to exercise Stripe; the backend test suite passes
# with none of these set, the same way it needs no real Anthropic key.
# STRIPE_WEBHOOK_SECRET comes from the Stripe Dashboard's webhook endpoint
# config, or from running `stripe listen` locally, which prints a temporary
# one for local testing. STRIPE_PRICE_ID is the Price ID (price_...) of the
# one recurring $19.99/month Price created in the Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

PORT=4000
