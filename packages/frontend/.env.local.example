# Copy to .env.local (Next.js convention) in this package if the backend
# isn't running on the default port. Must be NEXT_PUBLIC_-prefixed so it's
# available both server-side (page data fetches) and client-side (the
# intake/triage/clinician-decision forms call the API directly from the
# browser).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
